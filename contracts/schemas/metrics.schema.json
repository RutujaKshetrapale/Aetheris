{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metrics.schema.json",
  "title": "Aetheris Execution Metrics",
  "type": "object",
  "required": [
    "pathNodeCount",
    "pathEdgeCount",
    "algorithmPathCost",
    "terrainPathCost",
    "nodesVisited",
    "maxFrontierSize",
    "executionTimeMs",
    "totalSteps"
  ],
  "properties": {
    "pathNodeCount": {
      "type": "integer",
      "minimum": 0
    },
    "pathEdgeCount": {
      "type": "integer",
      "minimum": 0
    },
    "algorithmPathCost": {
      "type": ["integer", "null"]
    },
    "terrainPathCost": {
      "type": ["integer", "null"]
    },
    "nodesVisited": {
      "type": "integer",
      "minimum": 0
    },
    "maxFrontierSize": {
      "type": "integer",
      "minimum": 0
    },
    "executionTimeMs": {
      "type": "number",
      "minimum": 0.0
    },
    "totalSteps": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem-details.schema.json",
  "title": "RFC 9457 Problem Details",
  "type": "object",
  "required": ["status", "title"],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer"
    },
    "detail": {
      "type": "string"
    },
    "instance": {
      "type": "string",
      "format": "uri"
    }
  },
  "additionalProperties": true
}

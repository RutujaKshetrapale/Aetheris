{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pathfinding-response.schema.json",
  "title": "Aetheris Pathfinding Response",
  "type": "object",
  "required": [
    "algorithm",
    "pathFound",
    "path",
    "pathNodeCount",
    "pathEdgeCount",
    "algorithmPathCost",
    "terrainPathCost",
    "traceDeltas",
    "keyframes",
    "metrics",
    "reversible"
  ],
  "properties": {
    "algorithm": {
      "type": "string",
      "enum": [
        "BFS",
        "DFS",
        "DIJKSTRA",
        "ASTAR"
      ]
    },
    "pathFound": {
      "type": "boolean"
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^r[0-9]+c[0-9]+$"
      }
    },
    "pathNodeCount": {
      "type": "integer",
      "minimum": 0
    },
    "pathEdgeCount": {
      "type": "integer",
      "minimum": 0
    },
    "algorithmPathCost": {
      "type": [
        "integer",
        "null"
      ]
    },
    "terrainPathCost": {
      "type": [
        "integer",
        "null"
      ]
    },
    "traceDeltas": {
      "type": "array",
      "items": {
        "$ref": "trace-delta.schema.json"
      }
    },
    "keyframes": {
      "type": "array",
      "items": {
        "$ref": "keyframe.schema.json"
      }
    },
    "metrics": {
      "$ref": "metrics.schema.json"
    },
    "reversible": {
      "type": "boolean"
    },
    "noPathReason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "FRONTIER_EXHAUSTED",
        null
      ]
    }
  },
  "additionalProperties": false
}
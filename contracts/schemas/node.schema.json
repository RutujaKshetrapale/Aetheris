{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node.schema.json",
  "title": "Aetheris Node Definition",
  "type": "object",
  "required": ["id", "row", "col", "cellType"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^r[0-9]+c[0-9]+$",
      "description": "Deterministic canonical node identifier formatted as r{row}c{col}"
    },
    "row": {
      "type": "integer",
      "minimum": 0
    },
    "col": {
      "type": "integer",
      "minimum": 0
    },
    "cellType": {
      "type": "string",
      "enum": ["EMPTY", "WALL", "WEIGHTED", "START", "TARGET"]
    },
    "weight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 1,
      "description": "Integer terrain entry cost: EMPTY=1, WEIGHTED=2..100, START=0 entry cost"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace-delta.schema.json",
  "title": "Aetheris Reversible Trace Delta",
  "type": "object",
  "required": [
    "step",
    "action"
  ],
  "properties": {
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "type": "string",
      "enum": [
        "INITIALIZE",
        "ENQUEUE_FRONTIER",
        "DEQUEUE_FRONTIER",
        "EXAMINE_NODE",
        "UPDATE_METRICS",
        "CLOSE_NODE",
        "PATH_FOUND",
        "NO_PATH_FOUND"
      ]
    },
    "operationSubtype": {
      "type": [
        "string",
        "null"
      ]
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^r[0-9]+c[0-9]+$"
    },
    "beforeState": {
      "oneOf": [
        {
          "$ref": "cell-state.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "afterState": {
      "oneOf": [
        {
          "$ref": "cell-state.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "frontierSize": {
      "type": "integer",
      "minimum": 0
    },
    "heapSwaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "indexA",
          "indexB",
          "nodeA",
          "nodeB"
        ],
        "properties": {
          "indexA": {
            "type": "integer",
            "minimum": 0
          },
          "indexB": {
            "type": "integer",
            "minimum": 0
          },
          "nodeA": {
            "type": "string"
          },
          "nodeB": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "details": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
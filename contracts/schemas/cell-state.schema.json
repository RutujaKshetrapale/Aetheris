{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cell-state.schema.json",
  "title": "Aetheris Cell Dynamic State",
  "type": "object",
  "required": ["cellType", "traversalState", "inPath"],
  "properties": {
    "cellType": {
      "type": "string",
      "enum": ["EMPTY", "WALL", "WEIGHTED", "START", "TARGET"]
    },
    "traversalState": {
      "type": "string",
      "enum": ["UNVISITED", "FRONTIER", "ACTIVE", "CLOSED"]
    },
    "inPath": {
      "type": "boolean"
    },
    "gCost": {
      "type": ["integer", "null"]
    },
    "hCost": {
      "type": ["integer", "null"]
    },
    "fCost": {
      "type": ["integer", "null"]
    },
    "parentId": {
      "type": ["string", "null"],
      "pattern": "^r[0-9]+c[0-9]+$"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preset.schema.json",
  "title": "Aetheris Grid Preset",
  "type": "object",
  "required": ["id", "name", "grid"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "grid": {
      "$ref": "grid.schema.json"
    },
    "createdAt": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

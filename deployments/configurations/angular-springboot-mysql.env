# Configuration Profile 5: Angular + Spring Boot + MySQL
PROFILE=angular-springboot-mysql
FRONTEND_TYPE=angular
BACKEND_TYPE=springboot
DATABASE_TYPE=mysql

FRONTEND_PORT=4200
BACKEND_PORT=8080
DATABASE_PORT=3306

MYSQL_DATABASE=aetheris
MYSQL_USER=aetheris
MYSQL_PASSWORD=aetheris_password
MYSQL_ROOT_PASSWORD=root_password

AETHERIS_PERSISTENCE_ENGINE=MYSQL
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/aetheris?useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=aetheris
SPRING_DATASOURCE_PASSWORD=aetheris_password

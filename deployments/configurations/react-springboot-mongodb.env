# Configuration Profile 2: React + Spring Boot + MongoDB
PROFILE=react-springboot-mongodb
FRONTEND_TYPE=react
BACKEND_TYPE=springboot
DATABASE_TYPE=mongodb

FRONTEND_PORT=3000
BACKEND_PORT=8080
DATABASE_PORT=27017

MONGO_INITDB_DATABASE=aetheris
MONGO_INITDB_ROOT_USERNAME=aetheris
MONGO_INITDB_ROOT_PASSWORD=aetheris_password

AETHERIS_PERSISTENCE_ENGINE=MONGODB
SPRING_DATA_MONGODB_URI=mongodb://aetheris:aetheris_password@mongodb:27017/aetheris?authSource=admin

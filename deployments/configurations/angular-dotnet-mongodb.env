# Configuration Profile 8: Angular + .NET + MongoDB
PROFILE=angular-dotnet-mongodb
FRONTEND_TYPE=angular
BACKEND_TYPE=dotnet
DATABASE_TYPE=mongodb

FRONTEND_PORT=4200
BACKEND_PORT=5000
DATABASE_PORT=27017

MONGO_INITDB_DATABASE=aetheris
MONGO_INITDB_ROOT_USERNAME=aetheris
MONGO_INITDB_ROOT_PASSWORD=aetheris_password

Aetheris__Persistence__Engine=MONGODB
ConnectionStrings__Mongo=mongodb://aetheris:aetheris_password@mongodb:27017/aetheris?authSource=admin

# Configuration Profile 7: Angular + .NET + MySQL
PROFILE=angular-dotnet-mysql
FRONTEND_TYPE=angular
BACKEND_TYPE=dotnet
DATABASE_TYPE=mysql

FRONTEND_PORT=4200
BACKEND_PORT=5000
DATABASE_PORT=3306

MYSQL_DATABASE=aetheris
MYSQL_USER=aetheris
MYSQL_PASSWORD=aetheris_password
MYSQL_ROOT_PASSWORD=root_password

Aetheris__Persistence__Engine=MYSQL
ConnectionStrings__MySql=Server=mysql;Port=3306;Database=aetheris;User=aetheris;Password=aetheris_password;

# Stage 1: Build
FROM maven:3.10-eclipse-temurin-25-noble AS builder
WORKDIR /app

COPY backends/spring-boot/pom.xml ./
RUN mvn dependency:go-offline -B

COPY backends/spring-boot/src ./src
RUN mvn clean package -DskipTests

# Stage 2: Runtime
FROM eclipse-temurin:25-jre-noble
WORKDIR /app
COPY --from=builder /app/target/aetheris-backend-springboot-2.1.0.jar app.jar

ENV SERVER_PORT=8080
ENV AETHERIS_PERSISTENCE_ENGINE=IN_MEMORY

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]

# .NET 11 Backend Environment Example
ASPNETCORE_URLS=http://localhost:5000
Aetheris__Persistence__Engine=IN_MEMORY
Aetheris__Persistence__ConnectTimeoutMs=2000
AETHERIS_CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:4200

# MySQL 9.7 (used when Aetheris__Persistence__Engine=MYSQL)
Aetheris__Persistence__MySql__Host=127.0.0.1
Aetheris__Persistence__MySql__Port=3306
Aetheris__Persistence__MySql__Database=aetheris
Aetheris__Persistence__MySql__Username=aetheris
Aetheris__Persistence__MySql__Password=change_me_mysql_password
ConnectionStrings__MySql=Server=127.0.0.1;Port=3306;Database=aetheris;User=aetheris;Password=change_me_mysql_password;

# MongoDB 9.0 (used when Aetheris__Persistence__Engine=MONGODB)
Aetheris__Persistence__MongoDb__Uri=mongodb://aetheris:change_me_mongo_password@127.0.0.1:27017/aetheris?authSource=admin
Aetheris__Persistence__MongoDb__Database=aetheris
ConnectionStrings__Mongo=mongodb://aetheris:change_me_mongo_password@127.0.0.1:27017/aetheris?authSource=admin

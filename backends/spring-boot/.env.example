# Spring Boot 4.2.0 Backend Environment Example
SERVER_PORT=8080
AETHERIS_PERSISTENCE_ENGINE=IN_MEMORY
AETHERIS_DB_CONNECT_TIMEOUT_MS=2000
AETHERIS_CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:4200

# MySQL 9.7 (used when AETHERIS_PERSISTENCE_ENGINE=MYSQL)
AETHERIS_MYSQL_HOST=127.0.0.1
AETHERIS_MYSQL_PORT=3306
AETHERIS_MYSQL_DATABASE=aetheris
AETHERIS_MYSQL_USER=aetheris
AETHERIS_MYSQL_PASSWORD=change_me_mysql_password
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/aetheris?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=aetheris
SPRING_DATASOURCE_PASSWORD=change_me_mysql_password

# MongoDB 9.0 (used when AETHERIS_PERSISTENCE_ENGINE=MONGODB)
SPRING_DATA_MONGODB_URI=mongodb://aetheris:change_me_mongo_password@127.0.0.1:27017/aetheris?authSource=admin
SPRING_DATA_MONGODB_DATABASE=aetheris
